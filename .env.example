# OpenAI API Configuration
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_EMBEDDING_MODEL=text-embedding-3-large

# Tavily Search Configuration (for web search when manual lacks information)
TAVILY_API_KEY=your-tavily-api-key-here
ENABLE_WEB_SEARCH=true
WEB_SEARCH_MAX_RESULTS=5

# Application Configuration
APP_ENV=development
LOG_LEVEL=INFO

# Document Configuration
MEDICARE_DOC_VERSION=2026
MEDICARE_PDF_PATH=./docs/medicare_manual.pdf

# Index Configuration (Optimized for retrieval quality)
INDEX_PATH=./data/indexes
CHUNK_SIZE=600
CHUNK_OVERLAP=300
TOP_K_RETRIEVAL=20
TOP_K_RERANK=8

# Performance Optimization
ENABLE_QUERY_EXPANSION=true
ENABLE_INTENT_CLASSIFICATION=true
ENABLE_VERIFICATION=true
SKIP_VERIFICATION_ON_STREAM=true
USE_FAST_MODEL_FOR_CLASSIFICATION=true
FAST_MODEL=gpt-3.5-turbo

# Retrieval Weights (Hybrid Search)
BM25_WEIGHT=0.3
VECTOR_WEIGHT=0.7

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
